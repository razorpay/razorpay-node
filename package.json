{
  "name": "razorpay",
  "version": "3.0.0",
  "description": "Official Node SDK for Razorpay API",
  "main": "dist/razorpay",
  "module": "dist/razorpay.mjs",
  "typings": "dist/razorpay",
  "exports": {
    ".": {
      "types": "./dist/razorpay.d.ts",
      "import": "./dist/razorpay.mjs",
      "require": "./dist/razorpay.js"
    },
    "./dist/razorpay.mjs": "./dist/razorpay.mjs",
    "./dist/razorpay.js": "./dist/razorpay.js",
    "./dist/oAuthTokenClient": {
      "types": "./dist/oAuthTokenClient.d.ts",
      "default": "./dist/oAuthTokenClient.js"
    },
    "./dist/utils/nodeify": {
      "types": "./dist/utils/nodeify.d.ts",
      "default": "./dist/utils/nodeify.js"
    },
    "./dist/utils/razorpay-utils": {
      "types": "./dist/utils/razorpay-utils.d.ts",
      "default": "./dist/utils/razorpay-utils.js"
    },
    "./dist/utils/predefined-tests": {
      "default": "./dist/utils/predefined-tests.js"
    },
    "./dist/types/*": "./dist/types/*.d.ts"
  },
  "scripts": {
    "prepublish": "npm test",
    "clean": "rm -rf dist && mkdir dist",
    "cp-types": "mkdir -p dist/types dist/utils && cp lib/types/* dist/types && cp lib/utils/*.d.ts dist/utils",
    "cp-ts": "cp lib/razorpay.d.ts dist/ && cp lib/oAuthTokenClient.d.ts dist/ && npm run cp-types",
    "build": "npm run clean && tsup && npm run cp-ts",
    "debug": "npm run build && node-debug examples/index.js",
    "test": "npm run build && mocha --recursive test/",
    "coverage": "nyc report --reporter=text-lcov > coverage.lcov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/razorpay/razorpay-node.git"
  },
  "keywords": [
    "razorpay",
    "payments",
    "node",
    "nodejs",
    "razorpay-node"
  ],
  "files": [
    "dist"
  ],
  "mocha": {
    "recursive": true,
    "full-trace": true
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.12",
    "chai": "^4.3.4",
    "deep-equal": "^2.0.5",
    "mocha": "^9.0.0",
    "nock": "^13.1.1",
    "nyc": "^15.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.15.2"
  }
}
